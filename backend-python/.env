# ========================================
# SocietyFlow - Python/FastAPI Backend
# ========================================

# App
ENV=development

# ========================================
# DATABASE
# Key difference from TypeScript:
# postgresql:// → postgresql+asyncpg://
# ========================================
DATABASE_URL=postgresql+asyncpg://societyflow:ylGwPtkvar9nNGRR4rj440TXr4aXEuYc@dpg-d6esfcs1hm7c73fcms7g-a.oregon-postgres.render.com/societyflow_tft3

# ========================================
# JWT
# Same values as backend/.env
# ========================================
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ========================================
# CORS
# Python uses a JSON list format
# ========================================
CORS_ORIGINS=["http://localhost:3001","http://localhost:5500","http://127.0.0.1:5500"]

# ========================================
# ENCRYPTION
# Must be exactly 32 characters
# ========================================
ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key-in-production-now

# ========================================
# REDIS (optional - comment out to disable)
# ========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================================
# EMAIL (SMTP)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ========================================
# SMS (Twilio)
# ========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# GOOGLE SHEETS
# ========================================
GOOGLE_SHEETS_ENABLED=false
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/callback

# ========================================
# S3 STORAGE (optional)
# ========================================
S3_ENABLED=false
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=societyflow-receipts
