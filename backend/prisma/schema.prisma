// This is your Prisma schema file for SocietyFlow
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  MASTER_ADMIN
  SOCIETY_ADMIN
  COMMITTEE_USER
  RESIDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  mobile       String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  societiesCreated              Society[]                @relation("CreatedBySociety")
  societyAccess                 SocietyAccess[]
  receiptsCreated               Receipt[]                @relation("CreatedByUser")
  auditLogs                     AuditLog[]
  paymentUploadsCreated         PaymentUploadReference[] @relation("UploadedByUser")
  paymentUploadsVerified        PaymentUploadReference[] @relation("VerifiedByUser")

  @@index([email])
  @@index([role])
}

// ============================================
// SOCIETY & ACCESS MANAGEMENT
// ============================================

model Society {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  city            String
  state           String
  units           Int
  googleSheetId   String?  @unique
  googleSheetUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dataLastSynced  DateTime?

  // India Compliance Fields
  registeredAddress String?
  gstin             String?  @unique
  pan               String?
  contactEmail      String?
  contactPhone      String?

  createdByUserId String
  createdBy       User   @relation("CreatedBySociety", fields: [createdByUserId], references: [id])

  // Relations
  societyAccess    SocietyAccess[]
  members          Member[]
  billingHeads     BillingHead[]
  billingLineItems BillingLineItem[]
  invoices         Invoice[]
  payments         Payment[]
  receipts         Receipt[]
  notifications    Notification[]
  integrations     Integration[]
  auditLogs        AuditLog[]
  bankAccount      BankAccount?
  taxConfigs       TaxConfig[]
  receiptSequences ReceiptSequence[]
  monthClosures    MonthClosure[]
  ledgerEntries    LedgerEntry[]

  @@index([code])
  @@index([createdByUserId])
  @@index([googleSheetId])
  @@index([gstin])
}

enum AccessRole {
  ADMIN
  COMMITTEE
  VIEWER
}

model SocietyAccess {
  id        String     @id @default(uuid())
  societyId String
  userId    String
  society   Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessRole      AccessRole
  grantedByUserId String?
  grantedAt       DateTime   @default(now())

  @@unique([societyId, userId])
  @@index([userId])
  @@index([societyId])
}

// ============================================
// MEMBER MANAGEMENT
// ============================================

enum MemberStatus {
  ACTIVE
  INACTIVE
  VACANT
}

model Member {
  id        String       @id @default(uuid())
  societyId String
  society   Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name      String
  unitNo    String
  phone     String?
  email     String?
  status    MemberStatus @default(ACTIVE)

  // Flexible variables for billing calculations
  variables Json         @default("{}")

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  invoices      Invoice[]
  notifications Notification[]

  @@unique([societyId, unitNo])
  @@index([societyId])
  @@index([status])
}

// ============================================
// BILLING CONFIGURATION
// ============================================

model BillingHead {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lineItems BillingLineItem[]

  @@index([societyId])
  @@index([isActive])
}

enum BasisType {
  FLAT
  PER_BHK
  PER_SQFT
  PER_WATER_READING
  PER_DG_READING
  PER_METER_READING
  PER_CUSTOM_KEY
  FORMULA
}

enum Frequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

model BillingLineItem {
  id            String      @id @default(uuid())
  billingHeadId String
  billingHead   BillingHead @relation(fields: [billingHeadId], references: [id], onDelete: Cascade)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name        String
  basisType   BasisType
  rate        Float       @default(0)
  customKey   String?     // For PER_CUSTOM_KEY basis
  formulaText String?     // For FORMULA basis
  frequency   Frequency   @default(MONTHLY)
  taxable     Boolean     @default(false)
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingHeadId])
  @@index([societyId])
  @@index([isActive])
}

// ============================================
// INVOICE MANAGEMENT
// ============================================

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String        @id @default(uuid())
  societyId String
  society   Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  periodMonth Int // 1-12
  periodYear  Int

  // Invoice details
  invoiceNo   String?
  invoiceDate DateTime @default(now())
  dueDate     DateTime?

  // Amounts
  subtotal    Float
  taxAmount   Float
  roundOff    Float   @default(0)
  totalAmount Float

  // GST breakdown
  cgstAmount Float @default(0)
  sgstAmount Float @default(0)
  igstAmount Float @default(0)

  // Payment tracking
  amountPaid      Float @default(0)
  balanceAmount   Float @default(0)

  status      InvoiceStatus @default(GENERATED)
  generatedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lineItems         InvoiceLineItem[]
  payments          Payment[]
  receipts          Receipt[]
  notifications     Notification[]
  paymentUploads    PaymentUploadReference[]
  lineItems     InvoiceLineItem[]
  payments      Payment[]
  receipts      Receipt[]
  notifications Notification[]
  ledgerEntries LedgerEntry[]

  @@unique([societyId, memberId, periodMonth, periodYear])
  @@unique([societyId, invoiceNo])
  @@index([societyId])
  @@index([memberId])
  @@index([status])
  @@index([periodMonth, periodYear])
  @@index([invoiceNo])
}

model InvoiceLineItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  lineItemName String
  basisType    BasisType
  units        Float
  rate         Float
  amount       Float

  // GST details per line item
  taxable    Boolean @default(false)
  gstRate    Float   @default(0)
  cgstAmount Float   @default(0)
  sgstAmount Float   @default(0)
  igstAmount Float   @default(0)
  totalWithTax Float @default(0)

  // Metadata for audit trail
  meta Json @default("{}")

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ============================================
// PAYMENT & RECEIPT MANAGEMENT
// ============================================

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model Payment {
  id         String      @id @default(uuid())
  societyId  String
  society    Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId  String
  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountPaid  Float
  paidOn      DateTime
  mode        PaymentMode
  referenceNo String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([invoiceId])
  @@index([paidOn])
}

model Receipt {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  receiptNo      String
  issuedOn       DateTime
  fileUrl        String?
  createdByUserId String
  createdBy      User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, receiptNo])
  @@index([societyId])
  @@index([invoiceId])
  @@index([issuedOn])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

model Notification {
  id        String              @id @default(uuid())
  societyId String
  society   Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)

  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  providerRef String?             // Reference ID from email/SMS provider
  sentAt      DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([invoiceId])
  @@index([status])
  @@index([channel])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  societyId  String?
  society    Society? @relation(fields: [societyId], references: [id], onDelete: SetNull)

  action     String   // login_success, login_failure, society_create, member_create, etc.
  entityType String?  // user, society, member, invoice, etc.
  entityId   String?

  payload    Json     @default("{}")

  // Compliance tracking fields
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([societyId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// INTEGRATION MANAGEMENT
// ============================================

enum IntegrationType {
  GOOGLE_SHEETS
  EMAIL_SMTP
  SMS_PROVIDER
  PAYMENT_GATEWAY
}

model Integration {
  id        String          @id @default(uuid())
  societyId String
  society   Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)

  type     IntegrationType
  config   Json            @default("{}") // Encrypted if contains secrets
  isActive Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([type])
  @@index([isActive])
}

// ============================================
// BANK ACCOUNT MANAGEMENT
// ============================================

model BankAccount {
  id        String   @id @default(uuid())
  societyId String   @unique
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  accountName   String
  accountNumber String
  ifscCode      String
  bankName      String
  branchName    String?
  upiId         String?
  qrCodeUrl     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([isActive])
}

// ============================================
// PAYMENT UPLOAD REFERENCE
// ============================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentUploadReference {
  id        String             @id @default(uuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  uploadedByUserId String
  uploadedBy       User   @relation("UploadedByUser", fields: [uploadedByUserId], references: [id])

  referenceNo        String?
  transactionDate    DateTime
  amount             Float
  remarks            String?
  fileUrl            String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedBy         User?              @relation("VerifiedByUser", fields: [verifiedByUserId], references: [id])
  verifiedAt         DateTime?
  verificationNotes  String?
// INDIA COMPLIANCE MODULE
// ============================================

// GST and Tax Configuration
model TaxConfig {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  gstEnabled       Boolean @default(false)
  defaultGstRate   Float   @default(18)
  placeOfSupply    String  // State name
  isInterState     Boolean @default(false)

  // Item-wise overrides stored as JSON
  itemTaxRates     Json    @default("{}")

  // Exemption policies
  exemptionThreshold Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId])
  @@index([societyId])
}

// Receipt Sequence Configuration
enum ReceiptNumberFormat {
  FY_SOC_SEQ      // RCPT/{FY}/{SOC}/{####}
  SOC_YEAR_MONTH  // SOC-{YYYY}-{MM}-{SEQ}
  CUSTOM          // Custom format
}

model ReceiptSequence {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  format         ReceiptNumberFormat @default(FY_SOC_SEQ)
  customFormat   String?              // Template string
  prefix         String               @default("RCPT")
  currentSeq     Int                  @default(0)
  financialYear  String               // e.g., "2025-26"
  resetOnNewFY   Boolean              @default(true)

  // For concurrency control
  lastUpdatedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, financialYear])
  @@index([societyId])
}

// Month-End Closure/Lock Management
enum MonthClosureStatus {
  DRAFT
  REVIEWED
  APPROVED
  LOCKED
}

model MonthClosure {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  periodMonth Int      // 1-12
  periodYear  Int

  status      MonthClosureStatus @default(DRAFT)

  // Lock tracking
  lockedAt    DateTime?
  lockedBy    String?   // User ID who locked
  unlockReason String?

  // Approval workflow
  reviewedAt  DateTime?
  reviewedBy  String?   // User ID
  approvedAt  DateTime?
  approvedBy  String?   // User ID

  // Summary data (cached for reporting)
  totalBilled    Float @default(0)
  totalCollected Float @default(0)
  totalOutstanding Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([uploadedByUserId])
  @@index([verificationStatus])
  @@unique([societyId, periodMonth, periodYear])
  @@index([societyId])
  @@index([status])
  @@index([periodMonth, periodYear])
}

// Ledger Entries for Double-Entry Bookkeeping
enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransactionType {
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  OPENING_BALANCE
}

model LedgerEntry {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  memberId  String?  // Optional: for member-specific entries

  entryType       LedgerEntryType
  transactionType TransactionType
  amount          Float
  description     String

  // Accounting heads
  accountHead     String  // e.g., "Maintenance", "Water Charges", "Bank", "Cash"
  
  // Date tracking
  transactionDate DateTime
  
  // Reference tracking
  referenceNo     String?
  
  createdAt DateTime @default(now())
  
  @@index([societyId])
  @@index([invoiceId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([accountHead])
}
