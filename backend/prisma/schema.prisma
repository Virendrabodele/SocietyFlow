// This is your Prisma schema file for SocietyFlow
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  MASTER_ADMIN
  SOCIETY_ADMIN
  COMMITTEE_USER
  RESIDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  mobile       String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  societiesCreated       Society[]                @relation("CreatedBySociety")
  societyAccess          SocietyAccess[]
  receiptsCreated        Receipt[]                @relation("CreatedByUser")
  auditLogs              AuditLog[]
  paymentUploadsCreated  PaymentUploadReference[] @relation("UploadedByUser")
  paymentUploadsVerified PaymentUploadReference[] @relation("VerifiedByUser")

  @@index([email])
  @@index([role])
}

// ============================================
// SOCIETY & ACCESS MANAGEMENT
// ============================================

model Society {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  city           String
  state          String
  units          Int
  googleSheetId  String?   @unique
  googleSheetUrl String?
  address        String?
  registrationNo String?

  // India Compliance Fields
  registeredAddress String?
  gstin             String?
  pan               String?
  contactEmail      String?
  contactPhone      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  dataLastSynced DateTime?

  createdByUserId String
  createdBy       User   @relation("CreatedBySociety", fields: [createdByUserId], references: [id])

  // Relations
  societyAccess       SocietyAccess[]
  members             Member[]
  billingHeads        BillingHead[]
  billingLineItems    BillingLineItem[]
  invoices            Invoice[]
  payments            Payment[]
  receipts            Receipt[]
  notifications       Notification[]
  integrations        Integration[]
  auditLogs           AuditLog[]
  taxConfig           TaxConfig?
  invoiceSeriesConfig InvoiceSeriesConfig?
  receiptSeriesConfig ReceiptSeriesConfig?
  bankAccount         BankAccount?
  receiptSequences    ReceiptSequence[]
  monthClosures       MonthClosure[]
  ledgerEntries       LedgerEntry[]

  @@index([code])
  @@index([createdByUserId])
  @@index([googleSheetId])
}

enum AccessRole {
  ADMIN
  COMMITTEE
  VIEWER
}

model SocietyAccess {
  id        String     @id @default(uuid())
  societyId String
  userId    String
  society   Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessRole      AccessRole
  grantedByUserId String?
  grantedAt       DateTime   @default(now())

  @@unique([societyId, userId])
  @@index([userId])
  @@index([societyId])
}

// ============================================
// MEMBER MANAGEMENT
// ============================================

enum MemberStatus {
  ACTIVE
  INACTIVE
  VACANT
}

model Member {
  id        String       @id @default(uuid())
  societyId String
  society   Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name      String
  unitNo    String
  phone     String?
  email     String?
  status    MemberStatus @default(ACTIVE)

  // Flexible variables for billing calculations
  variables Json         @default("{}")

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  invoices      Invoice[]
  notifications Notification[]

  @@unique([societyId, unitNo])
  @@index([societyId])
  @@index([status])
}

// ============================================
// BILLING CONFIGURATION
// ============================================

model BillingHead {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lineItems BillingLineItem[]

  @@index([societyId])
  @@index([isActive])
}

enum BasisType {
  FLAT
  PER_BHK
  PER_SQFT
  PER_WATER_READING
  PER_DG_READING
  PER_METER_READING
  PER_CUSTOM_KEY
  FORMULA
}

enum Frequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

model BillingLineItem {
  id            String      @id @default(uuid())
  billingHeadId String
  billingHead   BillingHead @relation(fields: [billingHeadId], references: [id], onDelete: Cascade)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  name        String
  basisType   BasisType
  rate        Float       @default(0)
  customKey   String?
  formulaText String?
  frequency   Frequency   @default(MONTHLY)
  taxable     Boolean     @default(false)
  taxRate     Float       @default(0)
  sacHsnCode  String?
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingHeadId])
  @@index([societyId])
  @@index([isActive])
}

// ============================================
// INVOICE MANAGEMENT
// ============================================

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String        @id @default(uuid())
  societyId String
  society   Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  invoiceNo   String?
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  periodMonth Int
  periodYear  Int

  subtotal       Float
  taxableAmount  Float   @default(0)
  cgstAmount     Float   @default(0)
  sgstAmount     Float   @default(0)
  igstAmount     Float   @default(0)
  taxAmount      Float
  roundingAmount Float   @default(0)
  totalAmount    Float

  amountPaid    Float @default(0)
  balanceAmount Float @default(0)

  status      InvoiceStatus @default(GENERATED)
  isLocked    Boolean       @default(false)

  termsAndConditions  String?
  paymentInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lineItems      InvoiceLineItem[]
  taxLines       InvoiceTaxLine[]
  payments       Payment[]
  receipts       Receipt[]
  notifications  Notification[]
  paymentUploads PaymentUploadReference[]
  ledgerEntries  LedgerEntry[]

  @@unique([societyId, invoiceNo])
  @@unique([societyId, memberId, periodMonth, periodYear])
  @@index([societyId])
  @@index([memberId])
  @@index([status])
  @@index([periodMonth, periodYear])
  @@index([invoiceNo])
}

model InvoiceLineItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  lineItemName String
  basisType    BasisType
  units        Float
  rate         Float
  amount       Float

  taxable      Boolean @default(false)
  taxRate      Float   @default(0)
  sacHsnCode   String?
  cgstAmount   Float   @default(0)
  sgstAmount   Float   @default(0)
  igstAmount   Float   @default(0)
  totalWithTax Float   @default(0)

  meta Json @default("{}")

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ============================================
// PAYMENT & RECEIPT MANAGEMENT
// ============================================

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model Payment {
  id        String      @id @default(uuid())
  societyId String
  society   Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountPaid  Float
  paidOn      DateTime
  mode        PaymentMode
  referenceNo String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([invoiceId])
  @@index([paidOn])
}

enum ReceiptStatus {
  PROVISIONAL
  FINAL
  CANCELLED
}

model Receipt {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  receiptNo          String
  amountReceived     Float
  status             ReceiptStatus @default(FINAL)
  issuedOn           DateTime
  cancelledOn        DateTime?
  cancellationReason String?
  fileUrl            String?
  createdByUserId    String
  createdBy          User          @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, receiptNo])
  @@index([societyId])
  @@index([invoiceId])
  @@index([issuedOn])
  @@index([status])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

model Notification {
  id        String              @id @default(uuid())
  societyId String
  society   Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)

  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  providerRef String?
  sentAt      DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([invoiceId])
  @@index([status])
  @@index([channel])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  societyId String?
  society   Society? @relation(fields: [societyId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?

  payload        Json    @default("{}")
  beforeSnapshot Json?
  afterSnapshot  Json?
  sourceIp       String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([societyId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// INTEGRATION MANAGEMENT
// ============================================

enum IntegrationType {
  GOOGLE_SHEETS
  EMAIL_SMTP
  SMS_PROVIDER
  PAYMENT_GATEWAY
}

model Integration {
  id        String          @id @default(uuid())
  societyId String
  society   Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)

  type     IntegrationType
  config   Json            @default("{}")
  isActive Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([type])
  @@index([isActive])
}

// ============================================
// TAX & COMPLIANCE CONFIGURATION
// ============================================

enum TaxRegime {
  CGST_SGST
  IGST
}

model TaxConfig {
  id        String     @id @default(uuid())
  societyId String     @unique
  society   Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)

  gstEnabled      Boolean   @default(false)
  gstin           String?
  taxRegime       TaxRegime @default(CGST_SGST)
  defaultTaxRate  Float     @default(18)
  taxThreshold    Float?
  roundingPolicy  String    @default("NEAREST_RUPEE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
}

// ============================================
// BANK ACCOUNT MANAGEMENT
// ============================================

model BankAccount {
  id        String   @id @default(uuid())
  societyId String   @unique
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  accountName   String
  accountNumber String
  ifscCode      String
  bankName      String
  branchName    String?
  upiId         String?
  qrCodeUrl     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
}

// ============================================
// INVOICE & RECEIPT SERIES CONFIGURATION
// ============================================

model InvoiceSeriesConfig {
  id        String  @id @default(uuid())
  societyId String  @unique
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  prefix          String  @default("INV")
  includeYear     Boolean @default(true)
  includeSocCode  Boolean @default(true)
  separator       String  @default("/")
  currentSequence Int     @default(0)
  resetOnNewYear  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
}

model ReceiptSeriesConfig {
  id        String  @id @default(uuid())
  societyId String  @unique
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  prefix          String  @default("RCPT")
  includeYear     Boolean @default(true)
  includeSocCode  Boolean @default(true)
  separator       String  @default("/")
  currentSequence Int     @default(0)
  resetOnNewYear  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
}

model InvoiceTaxLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  taxRate      Float
  taxableValue Float
  cgst         Float  @default(0)
  sgst         Float  @default(0)
  igst         Float  @default(0)
  totalTax     Float

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ============================================
// PAYMENT UPLOAD REFERENCE
// ============================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentUploadReference {
  id        String             @id @default(uuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  uploadedByUserId String
  uploadedBy       User   @relation("UploadedByUser", fields: [uploadedByUserId], references: [id])

  referenceNo        String?
  transactionDate    DateTime
  amount             Float
  remarks            String?
  fileUrl            String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedBy         User?              @relation("VerifiedByUser", fields: [verifiedByUserId], references: [id])
  verifiedAt         DateTime?
  verificationNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([uploadedByUserId])
  @@index([verificationStatus])
}

// ============================================
// RECEIPT SEQUENCE (India FY-aware numbering)
// ============================================

enum ReceiptNumberFormat {
  FY_SOC_SEQ
  SOC_YEAR_MONTH
  CUSTOM
}

model ReceiptSequence {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  format         ReceiptNumberFormat @default(FY_SOC_SEQ)
  customFormat   String?
  prefix         String              @default("RCPT")
  currentSeq     Int                 @default(0)
  financialYear  String
  resetOnNewFY   Boolean             @default(true)

  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([societyId, financialYear])
  @@index([societyId])
}

// ============================================
// MONTH-END CLOSURE MANAGEMENT
// ============================================

enum MonthClosureStatus {
  DRAFT
  REVIEWED
  APPROVED
  LOCKED
}

model MonthClosure {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  periodMonth Int
  periodYear  Int

  status MonthClosureStatus @default(DRAFT)

  lockedAt     DateTime?
  lockedBy     String?
  unlockReason String?

  reviewedAt DateTime?
  reviewedBy String?
  approvedAt DateTime?
  approvedBy String?

  totalBilled      Float @default(0)
  totalCollected   Float @default(0)
  totalOutstanding Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, periodMonth, periodYear])
  @@index([societyId])
  @@index([status])
  @@index([periodMonth, periodYear])
}

// ============================================
// LEDGER ENTRIES (Double-Entry Bookkeeping)
// ============================================

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransactionType {
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  OPENING_BALANCE
}

model LedgerEntry {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  memberId String?

  entryType       LedgerEntryType
  transactionType TransactionType
  amount          Float
  description     String

  accountHead     String
  transactionDate DateTime
  referenceNo     String?

  createdAt DateTime @default(now())

  @@index([societyId])
  @@index([invoiceId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([accountHead])
}
