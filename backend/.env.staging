# ========================================
# STAGING ENVIRONMENT
# ========================================
NODE_ENV=staging
PORT=3000
API_PREFIX=/api/v1

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Set this via CI/CD secrets or environment variables
DATABASE_URL=

# ========================================
# JWT CONFIGURATION
# ========================================
# Set these via CI/CD secrets - NEVER commit real values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOGIN_RATE_LIMIT_MAX=10

# ========================================
# REDIS CONFIGURATION
# ========================================
# Set via CI/CD secrets or environment variables
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ========================================
# SMS CONFIGURATION
# ========================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# GOOGLE SHEETS INTEGRATION
# ========================================
GOOGLE_SHEETS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.societyflow.com/api/v1/callback

# ========================================
# OBJECT STORAGE
# ========================================
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=societyflow-receipts-staging

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN=https://staging.societyflow.com

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
