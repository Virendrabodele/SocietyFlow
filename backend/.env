# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL="postgresql://societyflow:societyflow123@localhost:5432/societyflow?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Redis Configuration (for BullMQ)
# Leave empty/commented to disable Redis. Set to a valid Redis URL on production if needed.
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Configuration (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SendGrid (alternative email provider)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@societyflow.com

# SMS Configuration (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 (alternative SMS provider)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SOCIET

# Google Sheets Integration
GOOGLE_SHEETS_ENABLED=true
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/callback

# Object Storage (S3-compatible)
S3_ENABLED=false
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=societyflow-receipts

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:5500,http://127.0.0.1:5500

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Encryption (for sensitive data like bank account numbers)
ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key-in-production-now
