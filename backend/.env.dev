# ========================================
# DEVELOPMENT ENVIRONMENT
# ========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL="postgresql://societyflow:societyflow123@localhost:5432/societyflow_dev?schema=public"

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# RATE LIMITING (More lenient for dev)
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=50

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# EMAIL CONFIGURATION (Dev - Console only)
# ========================================
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ========================================
# SMS CONFIGURATION (Dev - Disabled)
# ========================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# GOOGLE SHEETS INTEGRATION
# ========================================
GOOGLE_SHEETS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/callback

# ========================================
# OBJECT STORAGE
# ========================================
S3_ENABLED=false

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN=http://localhost:3001,http://localhost:5500,http://127.0.0.1:5500

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
