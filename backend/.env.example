# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL="postgresql://user:password@localhost:5432/societyflow?schema=public"

# ========================================
# JWT CONFIGURATION
# ========================================
# Generate strong secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-strong-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Primary email provider: smtp or sendgrid
EMAIL_PROVIDER=smtp

# SMTP Configuration (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SendGrid Configuration (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@societyflow.com

# ========================================
# SMS CONFIGURATION
# ========================================
# Primary SMS provider: twilio or msg91
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Configuration (Alternative - Indian SMS provider)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SOCIET

# ========================================
# GOOGLE SHEETS INTEGRATION
# ========================================
GOOGLE_SHEETS_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/callback

# ========================================
# OBJECT STORAGE (S3-compatible)
# ========================================
S3_ENABLED=false
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=societyflow-receipts

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN=http://localhost:3001,http://localhost:5500

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
