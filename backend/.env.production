# ========================================
# PRODUCTION ENVIRONMENT
# ========================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Set this via CI/CD secrets or environment variables - NEVER commit
DATABASE_URL=

# ========================================
# JWT CONFIGURATION
# ========================================
# CRITICAL: Set these via CI/CD secrets - NEVER commit real values
# Generate using: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# ========================================
# REDIS CONFIGURATION
# ========================================
# Set via CI/CD secrets or environment variables
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@societyflow.com

# ========================================
# SMS CONFIGURATION
# ========================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=SOCIET

# ========================================
# GOOGLE SHEETS INTEGRATION
# ========================================
GOOGLE_SHEETS_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://societyflow.com/api/v1/callback

# ========================================
# OBJECT STORAGE
# ========================================
S3_ENABLED=true
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=societyflow-receipts-production

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN=https://societyflow.com

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=warn
LOG_FORMAT=json
